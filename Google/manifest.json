{
  "manifest_version": 3,
  "name": "G1 $0.00 · Sat ⚡ Set",
  "version": "1.0.0",
  "description": "Injeksi penawaran Google One $0.00. Kanal Sat ⚡ Set t.me/sipalingsatset",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://one.google.com/*",
    "https://payments.google.com/*",
    "https://tokenized.play.google.com/*",
    "https://play.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "G1 $0.00 · Sat ⚡ Set",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://one.google.com/*",
        "https://payments.google.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://one.google.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://one.google.com/*",
        "https://payments.google.com/*"
      ],
      "js": [
        "presets.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://tokenized.play.google.com/*"
      ],
      "js": [
        "play_guard.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}